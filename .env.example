# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite for local/dev. For production (Vercel), use Postgres:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"
DATABASE_URL="file:./prisma/dev.db"

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
SESSION_SECRET=replace_with_long_random_secret
ADMIN_EMAIL=admin@alkalthoum.com
ADMIN_PASSWORD=replace_with_strong_password

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL="Al Kalthoum <noreply@alkalthoum.com>"
CONTACT_TO_EMAIL=info@alkalthoum.com

# ─── AI Assistant (optional) ──────────────────────────────────────────────────
GEMINI_API_KEY=

# ─── Public ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://alkalthoum.com
